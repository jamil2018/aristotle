# Target application. Use a non-production environment by default.
FACTORY_BASE_URL=http://127.0.0.1:3000
FACTORY_ENVIRONMENT=LOCAL

# Production remains read-only unless a human explicitly authorizes otherwise.
FACTORY_ALLOW_PRODUCTION_WRITES=false

# Comma-separated origins the browser may access.
FACTORY_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Evidence retention policy.
FACTORY_SCREENSHOT_POLICY=only-on-failure
FACTORY_TRACE_POLICY=retain-on-failure
FACTORY_VIDEO_POLICY=retain-on-failure
